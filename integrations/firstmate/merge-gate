#!/bin/sh
# merge-gate <task-id> <worktree|-> <head> <pr-url|->
# Run before a merge: it passes only when done-done passes the task's Checks block and the receipt for <head>.
# Both a PR and a local-only task (-, read from $FM_HOME/data/<task-id>/checks.md) are checked against the rules
# on the default branch, never the task's own branch. A nonzero exit refuses the merge; done-done's output says why.
# A worktree of - means the task recorded no worktree: there is no repo to check, so the gate refuses rather than check
# whatever folder it was called from.
set -eu
[ $# -eq 4 ] || { echo "usage: merge-gate <task-id> <worktree|-> <head> <pr-url|->" >&2; exit 2; }
id=$1 head=$3 pr=$4
[ "$2" != - ] || { echo "merge-gate: task $id recorded no worktree, so there is no repo to check; record its worktree, then re-run" >&2; exit 2; }
cd "$2" 2>/dev/null || { echo "merge-gate: cannot enter worktree $2" >&2; exit 2; }
ref=$(git symbolic-ref -q --short refs/remotes/origin/HEAD) ||
  for ref in origin/main origin/master main master; do
    git rev-parse -q --verify "$ref^{commit}" >/dev/null && break
  done || :
git cat-file -e "$ref:.done-done.yaml" 2>/dev/null ||
  echo "merge-gate: no .done-done.yaml at $ref, so done-done uses its default rules; merge the config to $ref first" >&2
if [ "$pr" = - ]; then
  done-done check --from "${FM_HOME:?merge-gate: FM_HOME is not set}/data/$id/checks.md" --trusted-ref "$ref"
else
  pr_head=$(gh pr view "$pr" --json headRefOid --jq .headRefOid)
  [ "$pr_head" = "$head" ] || { echo "merge-gate: $pr is at $pr_head, not $head; prove and receipt the PR's head" >&2; exit 1; }
  done-done check --from "$pr" --trusted-ref "$ref"
fi
done-done receipt --verify "$head"
